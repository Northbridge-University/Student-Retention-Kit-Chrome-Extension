<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>StudentRetentionKit.Five9VolumeHost</RootNamespace>
    <AssemblyName>Five9VolumeHost</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Native AOT: produces a single ~5-8MB exe with no .NET runtime
         dependency. Reduces antivirus false-positive rate vs PyInstaller
         and avoids needing a separate runtime install. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>

    <!-- Assembly metadata. Windows shows these in file Properties → Details
         and AV products use them as part of their reputation/heuristic
         scoring. A clear, descriptive identity reduces false positives. -->
    <AssemblyTitle>Student Retention Kit - Five9 Volume Host</AssemblyTitle>
    <Product>Student Retention Kit</Product>
    <Company>Student Retention Kit</Company>
    <Description>Chrome native messaging host that adjusts the per-process audio session volume of the Five9 Softphone, so the extension can mute/unmute calls without affecting other apps' volume.</Description>
    <Copyright>Student Retention Kit</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
